# Copy to watcher.env (same folder) and fill in. chmod 600 watcher.env — it holds secrets.

CANVAS_URL=https://canvas.auckland.ac.nz
# --- Login ---
# The session lives in cookies.json + browser_state.json (created by --relogin,
# --browser-login or --set-cookie). When it expires the watcher re-logs in by itself
# in a headless browser (needs Playwright, see README).
# Optional, for a fully hands-off re-login when the UoA login server has forgotten you
# too: your UoA username/password and the two-factor (TOTP) secret, the base32 key behind
# your authenticator app's 6-digit codes. Stored in plain text: keep this file chmod 600.
#UOA_USERNAME=
# Symbols are fine, no quotes needed: UOA_PASSWORD=p@ss#w$rd!
#UOA_PASSWORD=
#UOA_TOTP_SECRET=
# Tick UoA's "Remember me" on the two-factor page (1) or not (0)
#MFA_REMEMBER=1
# Minimum seconds between automatic browser login attempts
#RELOGIN_MIN_INTERVAL=600
# Set to 0 to never launch the browser
#BROWSER_RELOGIN=1
# Use a specific Chromium instead of Playwright's bundled one
#BROWSER_PATH=/usr/bin/chromium
# Only for Canvas sites that still allow personal access tokens:
#CANVAS_TOKEN=

# course_id:assignment_id, comma-separated. Find IDs with:  ./canvas_grade_watcher.py --list 142383
# (also in the URL: /courses/<course_id>/assignments/<assignment_id>)
# 142383:520781 = ENGGEN 403 Systems Report & Video, 142964:510982 = CIVIL 756 Phase 2: Report
WATCH=142383:520781,142964:510982

POLL_SECONDS=15
# Keep polling this long after the score is released (feedback often lands later)
POST_RELEASE_MINUTES=60

# --- Pushover (https://pushover.net) ---
# PUSHOVER_USER: your user key (dashboard). PUSHOVER_TOKEN: create an Application/API token.
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Emergency alerts repeat every RETRY s (min 30) until acknowledged, for up to EXPIRE s
# (300 = 5 min; Pushover allows up to 10800)
PUSHOVER_RETRY=30
PUSHOVER_EXPIRE=300
PUSHOVER_SOUND=persistent
